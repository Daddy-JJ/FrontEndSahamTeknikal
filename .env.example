# Development fixture is explicit. Never expose provider or service-role keys here.
DATA_MODE=fixture
# Required to serve synthetic data from a production build used as a local/dev preview.
# Never set this on the eventual live production project.
ALLOW_FIXTURE_PREVIEW=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional owner password login; server-only alias to the existing confirmed Auth user.
# Leave unset to keep GitHub available and password operations disabled.
APP_OWNER_USER_ID=
OWNER_LOGIN_USERNAME=daddyjj
OWNER_LOGIN_EMAIL=
APP_ORIGIN=http://localhost:3000
# Production requires verified Vercel WAF; local-test is loopback/nonproduction only.
AUTH_PASSWORD_PROTECTION=
# Enable only after SMTP and recovery callback delivery are verified.
AUTH_PASSWORD_RECOVERY_READY=false
